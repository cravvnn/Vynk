{
  "name": "vynk",
  "private": true,
  "version": "0.8.0",
  "workspaces": [
    "shared/protocol",
    "server"
  ],
  "scripts": {
    "build": "tsc -b shared/protocol server",
    "typecheck": "tsc -b shared/protocol server",
    "start": "node server/dist/index.js",
    "smoke": "node server/scripts/smoke.mjs",
    "test": "node tools/test-sync.mjs && node tools/test-jsonpoly.mjs && node --test tools/test-panel.mjs tools/test-base-panel.mjs",
    "check:tla": "node tools/tla/run.mjs",
    "test:panel-runtime": "node tools/test-panel-runtime.cjs",
    "test:delivery": "node --test tools/test-delivery.mjs",
    "test:pair": "node tools/ae-pair/run.mjs",
    "test:base": "node tools/test-base-http.mjs && node tools/test-replay-limit.mjs",
    "deploy:probe": "node tools/deploy-probe.mjs",
    "soak:system": "node tools/soak-system.mjs",
    "install-panel": "powershell -ExecutionPolicy Bypass -File tools/dev-install.ps1",
    "set-version": "node tools/set-version.mjs",
    "package": "node tools/package.mjs",
    "publish": "node tools/publish.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22"
  }
}
